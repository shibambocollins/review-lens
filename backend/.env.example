# Copy this file to .env and fill in real values. Never commit .env.

PORT=5000
FRONTEND_URL=http://localhost:5173

# --- AI Provider fallback chain: Gemini (primary) -> Groq -> Cloudflare Workers AI ---

# Gemini (primary)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Groq (first fallback) - https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Cloudflare Workers AI (second fallback) - https://dash.cloudflare.com
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct-fast
