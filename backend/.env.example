# Copy this file to .env and fill in real values. Never commit .env.

PORT=5000
FRONTEND_URL=http://localhost:5173

# --- AI Provider fallback chain: Gemini (primary) -> Groq -> Cloudflare Workers AI ---

# Gemini (primary)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Groq (first fallback) - https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Cloudflare Workers AI (second fallback) - https://dash.cloudflare.com
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct-fast

# --- Business photos ---
# Optional. Without this, every business gets a category-matched stock photo (coffee shop ->
# coffee photo, etc). With it, we first try to find the business's real photo via Google Places
# before falling back to the category match.
# Setup: Google Cloud Console -> enable "Places API" -> enable billing -> create an API key
# (restrict it to the Places API). Free tier includes a monthly credit; watch usage/billing.
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here
